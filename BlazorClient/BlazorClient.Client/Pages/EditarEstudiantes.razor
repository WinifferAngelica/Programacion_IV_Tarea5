@page "/estudiantes/editar/{Id:int}"

@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Editar Estudiante</h3>

@if (estudiante == null)
{
    <p>Cargando...</p>
}
else
{
    <EditForm Model="@estudiante" OnValidSubmit="@Guardar">

        <div class="mb-3">
            <label>Nombre</label>
            <InputText class="form-control"
                       @bind-Value="estudiante.Nombre" />
        </div>

        <div class="mb-3">
            <label>Fecha de Nacimiento</label>
            <InputDate class="form-control"
                       @bind-Value="estudiante.FechaNacimiento" />
        </div>

        <div class="mb-3">
            <label>Lugar de Nacimiento</label>
            <InputText class="form-control"
                       @bind-Value="estudiante.LugarNacimiento" />
        </div>

        <div class="mb-3">
            <label>Fecha de Ingreso</label>
            <InputDate class="form-control"
                       @bind-Value="estudiante.FechaIngreso" />
        </div>

        <div class="mb-3">
            <label>Casa</label>
            <InputText class="form-control"
                       @bind-Value="estudiante.Casa" />
        </div>

        <div class="mb-3">
            <label>Varita Mágica</label>
            <InputText class="form-control"
                       @bind-Value="estudiante.VaritaMagica" />
        </div>

        <div class="mb-3">
            <label>Tipo de Sangre Mágica</label>
            <InputText class="form-control"
                       @bind-Value="estudiante.TipoSangreMagica" />
        </div>

        <button type="submit" class="btn btn-primary">
            Guardar Cambios
        </button>

        <button type="button"
                class="btn btn-secondary ms-2"
                @onclick="Cancelar">
            Cancelar
        </button>

    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private BlazorClient.Client.Modelos.Estudiantes.Estudiantes? estudiante;

    protected override async Task OnInitializedAsync()
    {
        estudiante = await Http.GetFromJsonAsync<
            BlazorClient.Client.Modelos.Estudiantes.Estudiantes
        >($"api/Estudiantes/{Id}");
    }

    private async Task Guardar()
    {
        var respuesta = await Http.PutAsJsonAsync(
            $"api/Estudiantes/{Id}",
            estudiante
        );

        if (respuesta.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/estudiantes");
        }
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/estudiantes");
    }
}
