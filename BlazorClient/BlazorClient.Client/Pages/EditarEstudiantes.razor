@page "/estudiantes/editar/{Id:int}"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using Modelo = BlazorClient.Client.Modelos.Estudiantes.Estudiantes
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Editar Estudiante</PageTitle>

<h3>Editar estudiante</h3>

@if (cargando)
{
    <p>Cargando...</p>
}
else if (estudiante == null)
{
    <div class="alert alert-danger">@mensaje</div>
    <a href="/estudiantes" class="btn btn-secondary">Volver a la lista</a>
}
else
{
    <EstudianteForm Estudiante="estudiante"
                    OnGuardar="Guardar"
                    Guardando="guardando"
                    Mensaje="mensaje" />
}

@code {
    [Parameter] public int Id { get; set; }

    private Modelo? estudiante;
    private bool cargando = true;
    private bool guardando;
    private string? mensaje;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            estudiante = await Http.GetFromJsonAsync<Modelo>($"api/Estudiantes/{Id}");
            if (estudiante == null)
                mensaje = "El estudiante no existe.";
        }
        catch (Exception ex)
        {
            mensaje = $"No se pudo cargar el estudiante: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Guardar()
    {
        guardando = true;
        mensaje = null;

        try
        {
            var respuesta = await Http.PutAsJsonAsync($"api/Estudiantes/{Id}", estudiante);

            if (respuesta.IsSuccessStatusCode)
                Navigation.NavigateTo("/estudiantes");
            else
                mensaje = $"Error {(int)respuesta.StatusCode}: {await respuesta.Content.ReadAsStringAsync()}";
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }
}



