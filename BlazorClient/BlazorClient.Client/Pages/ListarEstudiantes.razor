@page "/estudiantes"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using Modelo = BlazorClient.Client.Modelos.Estudiantes.Estudiantes
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Listado de Estudiantes</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Estudiantes</h3>
    <a class="btn btn-primary" href="/estudiantes/crear">Crear estudiante</a>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

@if (cargando)
{
    <p>Cargando...</p>
}
else if (estudiantes.Count == 0)
{
    <p>No hay estudiantes registrados. Crea el primero con el botón de arriba.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Nacimiento</th>
                    <th>Lugar</th>
                    <th>Ingreso</th>
                    <th>Casa</th>
                    <th>Varita</th>
                    <th>Sangre</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in estudiantes)
                {
                    <tr>
                        <td>@e.Id</td>
                        <td>@e.Nombre</td>
                        <td>@e.FechaNacimiento.ToShortDateString()</td>
                        <td>@e.LugarNacimiento</td>
                        <td>@e.FechaIngreso.ToShortDateString()</td>
                        <td>@e.Casa</td>
                        <td>@e.VaritaMagica</td>
                        <td>@e.TipoSangreMagica</td>
                        <td class="text-nowrap">
                            <a class="btn btn-warning btn-sm" href="/estudiantes/editar/@e.Id">Editar</a>
                            <button type="button" class="btn btn-danger btn-sm ms-1"
                                    @onclick="() => Eliminar(e)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Modelo> estudiantes = new();
    private bool cargando = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            estudiantes = await Http.GetFromJsonAsync<List<Modelo>>("api/Estudiantes") ?? new();
        }
        catch (Exception ex)
        {
            error = $"No se pudo cargar la lista: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Eliminar(Modelo e)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar a {e.Nombre}?"))
            return;

        try
        {
            var respuesta = await Http.DeleteAsync($"api/Estudiantes/{e.Id}");
            if (respuesta.IsSuccessStatusCode)
                estudiantes.Remove(e);
            else
                error = $"No se pudo eliminar ({(int)respuesta.StatusCode}).";
        }
        catch (Exception ex)
        {
            error = $"Error al eliminar: {ex.Message}";
        }
    }
}



