@page "/estudiantes/crear"

@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Crear Estudiante</h3>

<EditForm Model="@estudiante" OnValidSubmit="@Guardar">

    <div class="mb-3">
        <label>Nombre</label>
        <InputText class="form-control"
                   @bind-Value="estudiante.Nombre" />
    </div>

    <div class="mb-3">
        <label>Fecha de Nacimiento</label>
        <InputDate class="form-control"
                   @bind-Value="estudiante.FechaNacimiento" />
    </div>

    <div class="mb-3">
        <label>Lugar de Nacimiento</label>
        <InputText class="form-control"
                   @bind-Value="estudiante.LugarNacimiento" />
    </div>

    <div class="mb-3">
        <label>Fecha de Ingreso</label>
        <InputDate class="form-control"
                   @bind-Value="estudiante.FechaIngreso" />
    </div>

    <div class="mb-3">
        <label>Casa</label>
        <InputText class="form-control"
                   @bind-Value="estudiante.Casa" />
    </div>

    <div class="mb-3">
        <label>Varita Mágica</label>
        <InputText class="form-control"
                   @bind-Value="estudiante.VaritaMagica" />
    </div>

    <div class="mb-3">
        <label>Tipo de Sangre Mágica</label>
        <InputText class="form-control"
                   @bind-Value="estudiante.TipoSangreMagica" />
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar
    </button>

</EditForm>

@code {
    private BlazorClient.Client.Modelos.Estudiantes.Estudiantes estudiante =
        new();

    private async Task Guardar()
    {
        var respuesta = await Http.PostAsJsonAsync(
            "api/Estudiantes",
            estudiante
        );

        if (respuesta.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/estudiantes");
        }
    }
}
