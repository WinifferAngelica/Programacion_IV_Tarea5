@page "/estudiantes/crear"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using Modelo = BlazorClient.Client.Modelos.Estudiantes.Estudiantes
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Crear Estudiante</PageTitle>

<h3>Crear estudiante</h3>

<EstudianteForm Estudiante="estudiante"
                OnGuardar="Guardar"
                Guardando="guardando"
                Mensaje="mensaje" />

@code {
    private Modelo estudiante = new()
    {
        FechaNacimiento = DateTime.Today.AddYears(-11),
        FechaIngreso = DateTime.Today
    };
    private bool guardando;
    private string? mensaje;

    private async Task Guardar()
    {
        guardando = true;
        mensaje = null;

        try
        {
            var respuesta = await Http.PostAsJsonAsync("api/Estudiantes", estudiante);

            if (respuesta.IsSuccessStatusCode)
                Navigation.NavigateTo("/estudiantes");
            else
                mensaje = $"Error {(int)respuesta.StatusCode}: {await respuesta.Content.ReadAsStringAsync()}";
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }
}




